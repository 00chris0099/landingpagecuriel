.hero-section {
  width: 100%;
  padding: 120px 0 96px;
  overflow: visible;
}

.hero-container {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: clamp(48px, 6vw, 96px);
  align-items: center;
}

.hero-content {
  min-width: 0;
  max-width: 700px;
}

.hero-title {
  margin-bottom: 24px;
  color: var(--primary-dark);
  font-family: 'Instrument Serif', serif;
  font-size: clamp(44px, 6vw, 88px);
  font-style: italic;
  line-height: 0.95;
  letter-spacing: -0.04em;
  max-width: 980px;
}

.hero-subtitle {
  max-width: 620px;
  margin-bottom: 18px;
  color: var(--text-dark);
  font-size: clamp(18px, 2vw, 20px);
  line-height: 1.75;
}

.hero-supporting {
  max-width: 560px;
  margin-bottom: 32px;
  color: var(--text-muted);
  font-size: 1.05rem;
  line-height: 1.75;
}

.hero-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 32px;
}

.hero-highlight-chip {
  padding: 10px 16px;
  border: 1px solid rgba(23, 50, 74, 0.14);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.82);
  color: var(--primary-dark);
  font-size: 0.92rem;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.hero-actions {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hero-card {
  min-width: 0;
}

.hero-card__outer {
  padding: 18px;
}

.hero-card__inner {
  border: 1px solid rgba(23, 50, 74, 0.12);
  border-radius: 26px;
  background: rgba(245, 239, 225, 0.62);
  padding: 20px;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.68);
}

.hero-card__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
  padding: 14px 16px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12px 28px rgba(23, 50, 74, 0.06);
}

.hero-card__label {
  color: var(--primary-accent);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.hero-card__meta-title {
  margin-top: 4px;
  color: var(--primary-dark);
  font-size: 1rem;
  font-weight: 600;
}

.hero-card__pill {
  padding: 9px 12px;
  border: 1px solid rgba(201, 168, 93, 0.3);
  border-radius: 999px;
  background: rgba(201, 168, 93, 0.14);
  color: var(--primary-dark);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.hero-card__visual {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360px;
  padding: 32px;
  border: 1px dashed rgba(23, 50, 74, 0.16);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.55);
  text-align: center;
}

.hero-card__visual-inner {
  max-width: 360px;
}

.hero-card__image {
  width: 100%;
  height: auto;
  border-radius: 12px;
  object-fit: cover;
}

.hero-card__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76px;
  height: 76px;
  margin: 0 auto 24px;
  border: 1px solid rgba(201, 168, 93, 0.34);
  border-radius: 999px;
  background: var(--white);
  box-shadow: 0 18px 38px rgba(23, 50, 74, 0.08);
}

.hero-card__visual-label {
  margin-bottom: 12px;
  color: var(--primary-accent);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.hero-card__title {
  margin-bottom: 16px;
  color: var(--primary-dark);
  font-family: 'Instrument Serif', serif;
  font-size: clamp(2rem, 3.1vw, 2.45rem);
  font-style: italic;
  line-height: 0.98;
}

.hero-card__copy {
  color: var(--text-muted);
  font-size: 1.02rem;
  line-height: 1.85;
}

.hero-card__stats {
  display: grid;
  gap: 12px;
  margin-top: 20px;
}

.hero-card__stat {
  padding: 16px;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.82);
  text-align: center;
  box-shadow: 0 10px 24px rgba(23, 50, 74, 0.05);
}

.hero-card__stat-value {
  color: var(--primary-dark);
  font-family: 'Instrument Serif', serif;
  font-size: 1.35rem;
  font-style: italic;
}

.hero-card__stat-label {
  margin-top: 4px;
  color: var(--text-muted);
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

@media (min-width: 640px) {
  .hero-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
  }
}

@media (min-width: 1024px) {
  .hero-container {
    grid-template-columns: minmax(0, 1fr) minmax(420px, 0.9fr);
  }

  .hero-mockup__image {
    max-width: 580px;
  }
}

@media (min-width: 768px) {
  .hero-benefits-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .hero-section {
    padding: 88px 0 72px;
  }

  .hero-title {
    font-size: clamp(38px, 12vw, 56px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
}

.hero-mockup {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-mockup__image {
  width: 100%;
  max-width: 520px;
  height: auto;
  border-radius: 24px;
  box-shadow: 0 24px 64px rgba(23, 50, 74, 0.12);
  object-fit: cover;
}

.hero-benefits-section {
  padding: 0 0 clamp(80px, 10vw, 120px);
}

.hero-benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 40px;
  text-align: center;
}

.hero-benefit-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.hero-benefit-icon {
  width: 48px;
  height: 48px;
}

.hero-benefit-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.hero-benefit-title {
  font-size: 28px;
  font-weight: 700;
  color: #17324A;
  line-height: 1.2;
}

.hero-benefit-sub {
  font-size: 16px;
  color: #40566B;
}

@media (max-width: 768px) {
  .hero-benefits-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }

  .hero-benefit-title {
    font-size: 24px;
  }
}

@media (max-width: 480px) {
  .hero-benefits-grid {
    grid-template-columns: 1fr;
  }
}
