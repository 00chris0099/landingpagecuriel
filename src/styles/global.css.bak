:root {
  --primary-dark: #17324a;
  --primary-accent: #c9a85d;
  --primary-soft: #f5efe1;
  --text-dark: #102333;
  --text-muted: #5a6b7a;
  --white: #ffffff;
  --line-grid: rgba(23, 50, 74, 0.12);
  --border-light: rgba(23, 50, 74, 0.14);
  --shadow-soft: 0 20px 60px rgba(23, 50, 74, 0.08);
  --shadow-card: 0 12px 32px rgba(23, 50, 74, 0.06);
  --container-max: 1240px;
  --section-space: clamp(72px, 9vw, 140px);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  font-family: 'Barlow', sans-serif;
  background-color: var(--white);
  background-image:
    linear-gradient(var(--line-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--line-grid) 1px, transparent 1px);
  background-size: 40px 40px;
  color: var(--text-dark);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

.font-heading {
  font-family: 'Instrument Serif', serif;
  font-style: italic;
}

.font-body {
  font-family: 'Barlow', sans-serif;
}

.container,
.site-shell {
  width: min(calc(100% - 48px), 1240px);
  margin-inline: auto;
}

.page-section,
.section-shell {
  width: 100%;
  padding: var(--section-space) 0;
}

.container--wide {
  width: 100%;
  max-width: 1280px;
  margin-inline: auto;
  padding-left: clamp(20px, 5vw, 64px);
  padding-right: clamp(20px, 5vw, 64px);
}

.section-heading-group {
  max-width: 760px;
  margin-bottom: clamp(40px, 5vw, 56px);
}

.section-title {
  color: var(--primary-dark);
  font-family: 'Instrument Serif', serif;
  font-size: clamp(44px, 6vw, 88px);
  font-style: italic;
  letter-spacing: -0.04em;
  line-height: 0.95;
  max-width: 980px;
}

.section-copy {
  color: var(--text-muted);
  font-family: 'Barlow', sans-serif;
  font-size: clamp(1.02rem, 1.6vw, 1.18rem);
  font-weight: 400;
  line-height: 1.8;
}

.highlight {
  color: var(--primary-accent);
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 11px 18px;
  border: 1px solid rgba(23, 50, 74, 0.08);
  border-radius: 999px;
  background: rgba(245, 239, 225, 0.92);
  color: var(--primary-dark);
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.surface-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid rgba(23, 50, 74, 0.15);
  border-radius: 24px;
  box-shadow: var(--shadow-soft);
}

.accent-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border: 1px solid rgba(201, 168, 93, 0.3);
  border-radius: 999px;
  background: rgba(201, 168, 93, 0.14);
  color: var(--primary-accent);
  font-size: 0.92rem;
  font-weight: 600;
}

.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 56px;
  padding: 0 30px;
  border-radius: 999px;
  font-size: 1rem;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    background-color 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}

.btn-primary {
  border: 1px solid transparent;
  background: var(--primary-accent);
  color: var(--text-dark);
  box-shadow: 0 12px 30px rgba(201, 168, 93, 0.22);
  font-weight: 600;
}

.btn-primary:hover {
  transform: translateY(-2px);
  background: #d4b86a;
  box-shadow: 0 18px 36px rgba(201, 168, 93, 0.28);
}

.btn-secondary {
  border: 1px solid var(--primary-dark);
  background: rgba(255, 255, 255, 0.9);
  color: var(--primary-dark);
  font-weight: 500;
}

.btn-secondary:hover {
  background: rgba(245, 239, 225, 0.9);
}

.grid-pattern {
  background-image:
    linear-gradient(rgba(23, 50, 74, 0.1) 1px, transparent 1px),
    linear-gradient(90deg, rgba(23, 50, 74, 0.1) 1px, transparent 1px);
  background-size: 40px 40px;
}

.footer-shell {
  padding-top: 0;
  padding-bottom: 0;
}

.floating-wa {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  border-radius: 999px;
  background: var(--primary-accent);
  box-shadow: 0 14px 28px rgba(23, 50, 74, 0.14);
  transition: transform 0.25s ease;
}

.floating-wa:hover {
  transform: scale(1.08);
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--primary-soft);
}

::-webkit-scrollbar-thumb {
  background: var(--primary-dark);
  border-radius: 999px;
  opacity: 0.4;
}

.header {
  height: 88px;
}

.site-main {
  padding-top: 0;
}

@media (max-width: 768px) {
  .container,
  .site-shell {
    width: min(calc(100% - 32px), 1240px);
  }

  .section-title,
  .hero-title {
    font-size: clamp(38px, 12vw, 56px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
}
